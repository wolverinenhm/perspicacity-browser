{
  "name": "perspicacity",
  "productName": "Perspicacity",
  "version": "0.2.0",
  "description": "Privacy browser with Tor routing, per-site circuit isolation, fingerprint uniformity and a sandboxed, human-approved agent.",
  "main": "src/main/main.js",
