<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Perspicacity" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/veil</item>
        <item name="android:colorPrimaryDark">@color/bg2</item>
        <item name="android:colorAccent">@color/veil</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg2</item>
        <item name="android:navigationBarColor">@color/bg2</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
    <style name="BarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
